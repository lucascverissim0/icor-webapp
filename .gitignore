data/bev_scores.json
data/sales_estimates_*.xlsx
data/sales_estimates_*.csv

# NOTE: data/passenger_car_data.xlsx, cache/gen_windows/ and data/generations.json
# ARE intentionally committed (pre-generated baseline so the dashboard isn't empty
# on a cold Streamlit Cloud start). Do not ignore them.
