{
  "name": "ICOR Python 3.12",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.15.0"
    },
    "ghcr.io/devcontainers/features/sshd:1.1.0": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/sshd",
    "ghcr.io/devcontainers/features/node"
  ],
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "docs/CODEX_HANDOFF.md",
        "docs/DEVELOPMENT.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "python -m pip install --disable-pip-version-check uv==0.11.3 && uv sync --locked --all-groups && cd web && npm ci",
  "portsAttributes": {
    "8000": {
      "label": "ICOR authenticated preview",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [
    8000
  ]
}