{
  "name": "ICOR Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "ui/app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "python -m pip install --disable-pip-version-check uv==0.11.3 && uv sync --locked --all-groups",
  "postAttachCommand": {
    "server": "uv run streamlit run ui/app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "ICOR application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
